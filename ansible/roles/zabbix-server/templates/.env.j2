# =============================================================================
# Переменные окружения для docker-compose Zabbix.
# Файл создаётся из шаблона Jinja2 — секреты из Ansible Vault.
# =============================================================================

ZBX_DB_NAME={{ zabbix_db_name }}
ZBX_DB_USER={{ zabbix_db_user }}
ZBX_DB_PASSWORD={{ zabbix_db_password }}
ZBX_SERVER_PORT={{ zabbix_server_port }}
ZBX_WEB_PORT={{ zabbix_web_port }}
ZBX_PHP_TZ={{ zabbix_php_timezone }}