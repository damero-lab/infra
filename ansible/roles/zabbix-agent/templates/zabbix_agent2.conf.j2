# =============================================================================
# Zabbix Agent 2 — конфиг (managed by Ansible)
#
# Шаблон Jinja2. Ansible подставит переменные:
#   zabbix_agent_server, zabbix_agent_server_port, zabbix_agent_hostname,
#   zabbix_agent_port
#
# НЕ РЕДАКТИРОВАТЬ ВРУЧНУЮ — при следующем ansible-playbook будет перезаписан.
# =============================================================================

# -----------------------------------------------------------------------------
# Основные параметры
# -----------------------------------------------------------------------------

# Порт агента (default: 10050)
ListenPort={{ zabbix_agent_port }}

# Список IP, от которых принимать подключения (passive checks)
# Через запятую, без пробелов. Zabbix Server шлёт запросы.
Server={{ zabbix_agent_server }}

# Список IP Zabbix Server для активных проверок (active checks)
# Агент сам отправляет метрики на сервер.
ServerActive={{ zabbix_agent_server }}:{{ zabbix_agent_server_port }}

# Уникальное имя хоста в Zabbix (должно совпадать с hostname, заданным в UI)
Hostname={{ zabbix_agent_hostname }}

# Не завершать работу при отсутствии подключения к серверу
# (по умолчанию: yes, агент продолжает попытки)
# Это полезно при временных сбоях.
# StartAgents=3

# -----------------------------------------------------------------------------
# Логи
# -----------------------------------------------------------------------------
LogType=file
LogFile=/var/log/zabbix/zabbix_agent2.log
LogFileSize=0
DebugLevel=3

# -----------------------------------------------------------------------------
# Лимиты
# -----------------------------------------------------------------------------
# Максимум параллельных процессов агента
# StartAgents=3

# Таймаут для проверок (секунды)
Timeout=3

# -----------------------------------------------------------------------------
# Модули и плагины
# -----------------------------------------------------------------------------
# В Agent 2 многое включено по умолчанию. Дополнительные модули
# (например, PostgreSQL, Docker) требуют отдельной настройки — отложим на потом.

# -----------------------------------------------------------------------------
# TLS (для продакшена, у нас не нужно)
# -----------------------------------------------------------------------------
# TLSConnect=unencrypted
# TLSAccept=unencrypted