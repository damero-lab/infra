# =============================================================================
# Модуль: vm
# Объявление провайдера, который использует модуль.
#
# ВАЖНО: каждый Terraform-модуль обязан объявлять, какие провайдеры
# он использует. Иначе Terraform по умолчанию ищет в namespace "hashicorp"
# (там провайдера для Proxmox нет).
# =============================================================================

terraform {
  required_providers {
    proxmox = {
      source  = "bpg/proxmox"
      version = ">= 0.50.0"
    }
  }
}