# =============================================================================
# Окружение: homelab
# Реестр виртуальных машин.
#
# Формат: map(object), ключ = имя VM.
# Для обычных VM указываем только template_id и ip_address — остальное
# берётся из значений по умолчанию в main.tf.
# Для особых VM (больше RAM, больше диск) — указываем явно.
#
# Реестр пуст — VM будут добавляться по мере работы.
# Первая VM — app-01, создадим её для проверки Terraform.
# =============================================================================

vms = {
  # --------------------------------------------------------------------------
  # Тестовая VM для проверки Terraform-модуля
  # --------------------------------------------------------------------------
  app-01 = {
    template_id = 101                # astra-template
    ip_address  = "172.16.0.211/24"
    tags        = ["test", "terraform"]
    # cores, memory, disk_size — не указаны, берутся дефолты (2 / 2048 / 20)
  }
}