# =============================================================================
# Окружение: homelab
# Реестр виртуальных машин.
#
# Формат: map(object), ключ = имя VM.
# Для обычных VM указываем только template_id и ip_address — остальное
# берётся из значений по умолчанию в main.tf (cores=2, memory=2048).
# Для особых VM (больше RAM/CPU) — указываем явно.
#
# Диск: по умолчанию (disk_size не указан) НАСЛЕДУЕТСЯ от шаблона.
# disk_size задаётся ТОЛЬКО для УВЕЛИЧЕНИЯ (Proxmox не умеет уменьшать).
# =============================================================================

vms = {
  # --------------------------------------------------------------------------
  # Тестовая VM — проверка Terraform-модуля
  # --------------------------------------------------------------------------
  app-01 = {
    template_id = 101 # astra-template
    ip_address  = "172.16.0.211/24"
    tags        = ["test", "terraform"]
    # cores, memory — дефолты (2 / 2048); диск наследуется от шаблона
  }

  # --------------------------------------------------------------------------
  # VM мониторинга — в будущем будет Zabbix/Prometheus/Grafana
  # --------------------------------------------------------------------------
  mon = {
    template_id = 101 # astra-template
    ip_address  = "172.16.0.200/24"
    memory      = 3072 # 3 GiB — больше, чем у обычной
    tags        = ["monitoring"]
    # cores — дефолт (2); диск наследуется от шаблона
  }

  # --------------------------------------------------------------------------
  # VM для Prometheus + Grafana (стек мониторинга, отдельно от Zabbix на mon)
  # --------------------------------------------------------------------------
  prom = {
    template_id = 101 # astra-template
    ip_address  = "172.16.0.201/24"
    memory      = 3072 # 3 GiB — Grafana + Prometheus + TSDB
    disk_size   = 40   # УВЕЛИЧИТЬ диск (TSDB Prometheus растёт); уменьшать нельзя
    tags        = ["monitoring", "prometheus"]
    # cores — дефолт (2)
  }
}