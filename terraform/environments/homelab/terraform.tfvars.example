# =============================================================================
# Окружение: homelab
# ПРИМЕР значений для terraform.tfvars.
#
# КАК ИСПОЛЬЗОВАТЬ:
#   1. Скопируй этот файл в terraform.tfvars (рядом, в этой же папке):
#        cp terraform.tfvars.example terraform.tfvars
#   2. Заполни реальными значениями.
#   3. Файл terraform.tfvars НЕ коммитится (в .gitignore).
#
# ВАЖНО: terraform.tfvars хранит секреты. Никогда не коммить его в git.
# =============================================================================

# -----------------------------------------------------------------------------
# Подключение к Proxmox
# -----------------------------------------------------------------------------
# URL API Proxmox. По умолчанию совпадает с дефолтом в variables.tf.
# proxmox_api_url = "https://172.16.0.199:8006/api2/json"

# ID API-токена Proxmox — формат: <user>@<realm>!<token-name>
proxmox_token_id = "terraform@pve!terraform-token"

# Секретная часть токена — UUID-строка, выданная Proxmox при создании токена
proxmox_token_secret = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# Игнорировать ошибки SSL (для самоподписанных сертификатов)
# proxmox_insecure = true

# -----------------------------------------------------------------------------
# Сетевые настройки
# -----------------------------------------------------------------------------
# IP-адрес шлюза (роутера)
# network_gateway = "172.16.0.1"

# -----------------------------------------------------------------------------
# SSH-ключ для доступа к VM
# -----------------------------------------------------------------------------
# Публичный SSH-ключ, который будет добавлен в authorized_keys на всех VM.
# Это СОДЕРЖИМОЕ файла ~/.ssh/id_ed25519_infra.pub на mgmt,
# которое начинается с "ssh-ed25519 AAAA..." и заканчивается комментарием.
#
# Получить содержимое ключа:
#   cat ~/.ssh/id_ed25519_infra.pub
# Затем вставить строку целиком в значение ниже.
ssh_public_key = "ssh-ed25519 AAAA...ЗАМЕНИ_НА_РЕАЛЬНЫЙ_КЛЮЧ... infra@mgmt"